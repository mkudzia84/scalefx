# .claude/ holds local state (settings, scheduled-task locks) — ignore it,
# but TRACK the shared skill definitions so the team gets them.
.claude/*
!.claude/skills/

# System files
Thumbs.db
tools/ffmpeg/

# MP3 encode workspace — local ffmpeg run area
tools/mp3_workspace/

# IDF build artifacts.  managed_components/ is the heavyweight (~430 MB of IDF
# component sources pulled by the component manager); the resolved sdkconfig.*
# + the generated root CMakeLists.txt are regenerated per `pio run`.
# Run `tools/setup-hubfx-idf-deps.ps1` to bootstrap a fresh clone.
# NOTE: sdkconfig.defaults is NOT ignored — under framework=espidf it is the
# hand-authored board config (PSRAM/USB-host/console/partitions) and the source
# of truth; it is used as-is (not regenerated) by a normal build.
controllers/hubfx/esp32s3/.dummy/
controllers/hubfx/esp32s3/managed_components/
controllers/hubfx/esp32s3/sdkconfig
controllers/hubfx/esp32s3/sdkconfig.esp32s3
controllers/hubfx/esp32s3/sdkconfig.esp32s3_debug
controllers/hubfx/esp32s3/sdkconfig.esp32s3_release
controllers/hubfx/esp32s3/dependencies.lock
controllers/hubfx/esp32s3/CMakeLists.txt
# Note: src/CMakeLists.txt IS tracked (we override the auto-generated
# default to add esp-dsp as a component REQUIRES — Phase 5 of
# feature/idf-component-build).

# Local capture/scratch files
subscribe_capture.txt
subscribe_err.txt
app/go/studio/frontend/sc-out.txt
_bringup_backup/

# Local device backups (e.g. configs pulled off a board before a card swap /
# reflash — see backups/flash-config-<date>/).  Operator-local, not source.
backups/

# Studio distribution packages
dist/
tas5825m_beep_*.zip
scalefx-coredump*.bin
