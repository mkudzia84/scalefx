# Minimal probe config.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# Console on UART0 (GPIO43/44 → CH343 → USB0) at 115200 so a plain serial
# monitor reads the scan.  (The real firmware sets console=NONE; the probe does not.)
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
